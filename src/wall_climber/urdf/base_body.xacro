<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rounded_panel" params="x y z width height depth radius mat_name rgba">
    <visual>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry>
        <box size="${width - 2.0 * radius} ${height} ${depth}"/>
      </geometry>
      <material name="${mat_name}">
        <color rgba="${rgba}"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry>
        <box size="${width} ${height - 2.0 * radius} ${depth}"/>
      </geometry>
      <material name="${mat_name}">
        <color rgba="${rgba}"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${x - width / 2.0 + radius} ${y - height / 2.0 + radius} ${z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${depth}"/>
      </geometry>
      <material name="${mat_name}">
        <color rgba="${rgba}"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${x + width / 2.0 - radius} ${y - height / 2.0 + radius} ${z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${depth}"/>
      </geometry>
      <material name="${mat_name}">
        <color rgba="${rgba}"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${x - width / 2.0 + radius} ${y + height / 2.0 - radius} ${z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${depth}"/>
      </geometry>
      <material name="${mat_name}">
        <color rgba="${rgba}"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${x + width / 2.0 - radius} ${y + height / 2.0 - radius} ${z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${depth}"/>
      </geometry>
      <material name="${mat_name}">
        <color rgba="${rgba}"/>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="base_body" params="">
    <xacro:property name="robot_cfg" value="${xacro.load_yaml('$(find wall_climber)/config/cable_robot.yaml')}"/>
    <xacro:property name="carriage_cfg" value="${robot_cfg['carriage']}"/>

    <xacro:property name="attach_left_local_y" value="${-carriage_cfg['attachment_left_y']}"/>
    <xacro:property name="attach_right_local_y" value="${-carriage_cfg['attachment_right_y']}"/>
    <xacro:property name="mount_tip_z" value="${-(carriage_cfg['depth'] / 2.0) + 0.002}"/>

    <xacro:property name="front_mask_w" value="${carriage_cfg['width'] - 0.020}"/>
    <xacro:property name="front_mask_h" value="${carriage_cfg['height'] - 0.018}"/>
    <xacro:property name="front_mask_d" value="${carriage_cfg['depth'] * 0.18}"/>
    <xacro:property name="front_mask_r" value="0.014"/>
    <xacro:property name="front_mask_z" value="${carriage_cfg['depth'] / 2.0 - front_mask_d / 2.0 - 0.0005}"/>

    <xacro:property name="top_band_w" value="${front_mask_w * 0.72}"/>
    <xacro:property name="top_band_h" value="${carriage_cfg['height'] * 0.12}"/>
    <xacro:property name="top_band_d" value="${carriage_cfg['depth'] * 0.10}"/>
    <xacro:property name="top_band_z" value="${carriage_cfg['depth'] / 2.0 - top_band_d / 2.0 - 0.0002}"/>

    <xacro:property name="chin_band_w" value="${front_mask_w * 0.78}"/>
    <xacro:property name="chin_band_h" value="${carriage_cfg['height'] * 0.10}"/>
    <xacro:property name="chin_band_d" value="${carriage_cfg['depth'] * 0.09}"/>
    <xacro:property name="chin_band_z" value="${carriage_cfg['depth'] / 2.0 - chin_band_d / 2.0}"/>

    <xacro:property name="side_rail_w" value="${carriage_cfg['width'] * 0.075}"/>
    <xacro:property name="side_rail_h" value="${carriage_cfg['height'] * 0.64}"/>
    <xacro:property name="side_rail_d" value="${carriage_cfg['depth'] * 0.09}"/>
    <xacro:property name="side_rail_z" value="${carriage_cfg['depth'] / 2.0 - side_rail_d / 2.0}"/>

    <xacro:property name="service_panel_w" value="${carriage_cfg['width'] * 0.15}"/>
    <xacro:property name="service_panel_h" value="${carriage_cfg['height'] * 0.46}"/>
    <xacro:property name="service_panel_d" value="${carriage_cfg['depth'] * 0.10}"/>
    <xacro:property name="service_panel_x" value="${-carriage_cfg['width'] * 0.28}"/>
    <xacro:property name="service_panel_y" value="${-carriage_cfg['height'] * 0.04}"/>
    <xacro:property name="service_panel_z" value="${carriage_cfg['depth'] / 2.0 - service_panel_d / 2.0}"/>

    <xacro:property name="arm_exit_slot_x" value="${carriage_cfg['width'] / 2.0 + 0.0025}"/>
    <xacro:property name="arm_exit_slot_y" value="${-carriage_cfg['pen_offset_y']}"/>
    <xacro:property name="arm_exit_slot_w" value="0.005"/>
    <xacro:property name="arm_exit_slot_h" value="${carriage_cfg['height'] * 0.50}"/>
    <xacro:property name="arm_exit_slot_d" value="${carriage_cfg['depth'] * 0.48}"/>
    <xacro:property name="arm_exit_slot_z" value="${-(carriage_cfg['depth'] / 2.0) + 0.0195}"/>
    <xacro:property name="arm_exit_bezel_t" value="0.006"/>
    <xacro:property name="arm_exit_bezel_x" value="${carriage_cfg['width'] / 2.0 + 0.005}"/>
    <xacro:property name="arm_exit_rail_x" value="${carriage_cfg['width'] / 2.0 + 0.006}"/>
    <xacro:property name="arm_exit_rail_h" value="0.0036"/>
    <xacro:property name="arm_exit_rail_d" value="${arm_exit_slot_d * 0.8}"/>

    <xacro:property name="vent_slit_w" value="${service_panel_w * 0.68}"/>
    <xacro:property name="vent_slit_h" value="0.0040"/>
    <xacro:property name="vent_slit_d" value="${service_panel_d * 0.48}"/>
    <xacro:property name="vent_slit_z" value="${service_panel_z + service_panel_d * 0.32}"/>
    <xacro:property name="accent_bolt_r" value="0.0031"/>
    <xacro:property name="accent_bolt_l" value="0.0028"/>
    <xacro:property name="accent_bolt_z" value="${carriage_cfg['depth'] / 2.0 + accent_bolt_l / 2.0 + 0.0006}"/>

    <link name="base_link">
      <visual>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="chassis_joint" type="fixed">
      <parent link="base_link"/>
      <child link="chassis"/>
      <origin xyz="0 0 ${carriage_cfg['root_to_chassis_z']}" rpy="0 0 0"/>
    </joint>

    <link name="chassis">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${carriage_cfg['width']} ${carriage_cfg['height']} ${carriage_cfg['depth']}"/>
        </geometry>
        <material name="robot_orange_shell_mat">
          <color rgba="0.97 0.36 0.08 1.0"/>
        </material>
      </visual>

      <xacro:rounded_panel
        x="0" y="0" z="${front_mask_z}"
        width="${front_mask_w}" height="${front_mask_h}" depth="${front_mask_d}" radius="${front_mask_r}"
        mat_name="robot_front_mask_mat" rgba="0.12 0.14 0.17 1.0"/>

      <visual>
        <origin xyz="0 ${carriage_cfg['height'] * 0.33} ${top_band_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${top_band_w} ${top_band_h} ${top_band_d}"/>
        </geometry>
        <material name="robot_top_band_mat">
          <color rgba="0.20 0.23 0.28 1.0"/>
        </material>
      </visual>

      <visual>
        <origin xyz="${arm_exit_slot_x} ${arm_exit_slot_y} ${arm_exit_slot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${arm_exit_slot_w} ${arm_exit_slot_h} ${arm_exit_slot_d}"/>
        </geometry>
        <material name="robot_arm_exit_recess_mat">
          <color rgba="0.025 0.027 0.032 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${arm_exit_bezel_x} ${arm_exit_slot_y + arm_exit_slot_h / 2.0 + arm_exit_bezel_t / 2.0} ${arm_exit_slot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="0.004 ${arm_exit_bezel_t} ${arm_exit_slot_d + 2.0 * arm_exit_bezel_t}"/>
        </geometry>
        <material name="robot_arm_exit_bezel_mat">
          <color rgba="0.20 0.23 0.28 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${arm_exit_bezel_x} ${arm_exit_slot_y - arm_exit_slot_h / 2.0 - arm_exit_bezel_t / 2.0} ${arm_exit_slot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="0.004 ${arm_exit_bezel_t} ${arm_exit_slot_d + 2.0 * arm_exit_bezel_t}"/>
        </geometry>
        <material name="robot_arm_exit_bezel_mat">
          <color rgba="0.20 0.23 0.28 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${arm_exit_bezel_x} ${arm_exit_slot_y} ${arm_exit_slot_z + arm_exit_slot_d / 2.0 + arm_exit_bezel_t / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.004 ${arm_exit_slot_h} ${arm_exit_bezel_t}"/>
        </geometry>
        <material name="robot_arm_exit_bezel_mat">
          <color rgba="0.20 0.23 0.28 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${arm_exit_bezel_x} ${arm_exit_slot_y} ${arm_exit_slot_z - arm_exit_slot_d / 2.0 - arm_exit_bezel_t / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.004 ${arm_exit_slot_h} ${arm_exit_bezel_t}"/>
        </geometry>
        <material name="robot_arm_exit_bezel_mat">
          <color rgba="0.20 0.23 0.28 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${arm_exit_rail_x} ${arm_exit_slot_y + arm_exit_slot_h * 0.24} ${arm_exit_slot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="0.003 ${arm_exit_rail_h} ${arm_exit_rail_d}"/>
        </geometry>
        <material name="robot_arm_exit_rail_mat">
          <color rgba="0.54 0.58 0.64 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="${arm_exit_rail_x} ${arm_exit_slot_y - arm_exit_slot_h * 0.24} ${arm_exit_slot_z}" rpy="0 0 0"/>
        <geometry>
          <box size="0.003 ${arm_exit_rail_h} ${arm_exit_rail_d}"/>
        </geometry>
        <material name="robot_arm_exit_rail_mat">
          <color rgba="0.54 0.58 0.64 1.0"/>
        </material>
      </visual>

      <visual>
        <origin xyz="${-front_mask_w / 2.0 + 0.018} ${front_mask_h / 2.0 - 0.018} ${accent_bolt_z}" rpy="0 0 0"/>
        <geometry><cylinder radius="${accent_bolt_r}" length="${accent_bolt_l}"/></geometry>
        <material name="robot_corner_bolt_mat"><color rgba="0.64 0.68 0.74 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${front_mask_w / 2.0 - 0.018} ${front_mask_h / 2.0 - 0.018} ${accent_bolt_z}" rpy="0 0 0"/>
        <geometry><cylinder radius="${accent_bolt_r}" length="${accent_bolt_l}"/></geometry>
        <material name="robot_corner_bolt_mat"><color rgba="0.64 0.68 0.74 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${-front_mask_w / 2.0 + 0.018} ${-front_mask_h / 2.0 + 0.018} ${accent_bolt_z}" rpy="0 0 0"/>
        <geometry><cylinder radius="${accent_bolt_r}" length="${accent_bolt_l}"/></geometry>
        <material name="robot_corner_bolt_mat"><color rgba="0.64 0.68 0.74 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${front_mask_w / 2.0 - 0.018} ${-front_mask_h / 2.0 + 0.018} ${accent_bolt_z}" rpy="0 0 0"/>
        <geometry><cylinder radius="${accent_bolt_r}" length="${accent_bolt_l}"/></geometry>
        <material name="robot_corner_bolt_mat"><color rgba="0.64 0.68 0.74 1.0"/></material>
      </visual>

      <!-- Decorative corner brackets clamped over the four VERTICAL edges of
           the orange shell. Each is an L-shaped cap (two thin plates meeting
           at the edge) plus an accent stud, so the corner reads as reinforced.
           Centred in Z so it never reaches the board; cosmetic only. -->
      <xacro:property name="cc_x" value="${carriage_cfg['width'] / 2.0}"/>
      <xacro:property name="cc_y" value="${carriage_cfg['height'] / 2.0}"/>
      <xacro:property name="cc_plate" value="0.022"/>
      <xacro:property name="cc_t" value="0.006"/>
      <xacro:property name="cc_z" value="${carriage_cfg['depth'] * 0.46}"/>

      <!-- top-left corner -->
      <visual>
        <origin xyz="${-(cc_x + cc_t / 2.0)} ${cc_y - cc_plate / 2.0} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_t} ${cc_plate} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${-(cc_x - cc_plate / 2.0)} ${cc_y + cc_t / 2.0} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_plate} ${cc_t} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${-(cc_x + cc_t)} ${cc_y + cc_t} 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0052" length="${cc_z}"/></geometry>
        <material name="robot_corner_stud_mat"><color rgba="0.60 0.64 0.70 1.0"/></material>
      </visual>

      <!-- top-right corner -->
      <visual>
        <origin xyz="${cc_x + cc_t / 2.0} ${cc_y - cc_plate / 2.0} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_t} ${cc_plate} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${cc_x - cc_plate / 2.0} ${cc_y + cc_t / 2.0} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_plate} ${cc_t} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${cc_x + cc_t} ${cc_y + cc_t} 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0052" length="${cc_z}"/></geometry>
        <material name="robot_corner_stud_mat"><color rgba="0.60 0.64 0.70 1.0"/></material>
      </visual>

      <!-- bottom-left corner -->
      <visual>
        <origin xyz="${-(cc_x + cc_t / 2.0)} ${-(cc_y - cc_plate / 2.0)} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_t} ${cc_plate} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${-(cc_x - cc_plate / 2.0)} ${-(cc_y + cc_t / 2.0)} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_plate} ${cc_t} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${-(cc_x + cc_t)} ${-(cc_y + cc_t)} 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0052" length="${cc_z}"/></geometry>
        <material name="robot_corner_stud_mat"><color rgba="0.60 0.64 0.70 1.0"/></material>
      </visual>

      <!-- bottom-right corner -->
      <visual>
        <origin xyz="${cc_x + cc_t / 2.0} ${-(cc_y - cc_plate / 2.0)} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_t} ${cc_plate} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${cc_x - cc_plate / 2.0} ${-(cc_y + cc_t / 2.0)} 0" rpy="0 0 0"/>
        <geometry><box size="${cc_plate} ${cc_t} ${cc_z}"/></geometry>
        <material name="robot_corner_bracket_mat"><color rgba="0.15 0.17 0.20 1.0"/></material>
      </visual>
      <visual>
        <origin xyz="${cc_x + cc_t} ${-(cc_y + cc_t)} 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0052" length="${cc_z}"/></geometry>
        <material name="robot_corner_stud_mat"><color rgba="0.60 0.64 0.70 1.0"/></material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${carriage_cfg['width']} ${carriage_cfg['height']} ${carriage_cfg['depth']}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${carriage_cfg['mass']}"/>
        <inertia ixx="0.006" ixy="0.0" ixz="0.0" iyy="0.006" iyz="0.0" izz="0.006"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>
