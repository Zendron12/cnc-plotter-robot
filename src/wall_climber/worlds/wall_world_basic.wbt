#VRML_SIM R2023b utf8

WorldInfo {
  info [ "Four-Cable Drawing Robot - Clean Environment" ]
  title "Four-Cable Drawing Robot Lab"
  gravity 9.81
  basicTimeStep 16
  contactProperties [ ContactProperties { coulombFriction [ 2.5 ] } ]
}

Viewpoint {
  orientation -0.05 0.05 0.99 1.6
  position 5.0 -6.0 3.5
}

Background {
  skyColor [
    0.68 0.74 0.84
    0.82 0.86 0.92
    0.94 0.96 0.98
  ]
}

DirectionalLight { ambientIntensity 0.55 direction -0.42 0.60 -1 intensity 1.15 castShadows TRUE }
DirectionalLight { ambientIntensity 0.10 direction 0.55 -0.20 -0.70 intensity 0.45 castShadows FALSE }

# --- Base Floor ---
Solid {
  translation 0 0 -0.06
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.54 0.56 0.60
        roughness 0.97
        metalness 0
      }
      geometry Box {
        size 12.0 12.0 0.12
      }
    }
  ]
  name "floor_base"
  boundingObject Box { size 12.0 12.0 0.12 }
  locked TRUE
}

# --- Mounting Wall ---
Solid {
  translation 0 2.5 1.75
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.92 0.92 0.88
        roughness 1
        metalness 0
        transparency 0
      }
      geometry Box {
        size 8.0 0.12 3.7
      }
    }
  ]
  name "front_wall_panel"
  boundingObject Box { size 8.0 0.12 3.7 }
  locked TRUE
}

# --- Whiteboard Frame (dark border) ---
Solid {
  translation 0 2.43 1.8
  children [
    Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 roughness 1 metalness 0 transparency 0 } geometry Box { size 6.5 0.025 3.2 } }
  ]
  name "whiteboard_frame"
  boundingObject Box { size 6.5 0.025 3.2 }
  locked TRUE
}

# --- Whiteboard Writing Surface (white, on top of frame) ---
Solid {
  translation 0 2.415 1.8
  children [
    Shape { appearance PBRAppearance { baseColor 1 1 1 roughness 1 metalness 0 transparency 0 } geometry Box { size 6.3 0.01 3.0 } }
  ]
  name "whiteboard"
  boundingObject Box { size 6.3 0.01 3.0 }
  locked TRUE
}

# --- Cable Anchor Mounts ---
# Visual-only motors (cable supervisor owns the kinematics).
# Square plate flush on the dark frame + a vertical cylinder standing on
# it like a teacup on a saucer (base embedded a little), with a gray ring
# wrapping its middle. Each base has a DEF status light: green moving /
# red idle.
Solid {
  translation -3.168 2.392 3.3
  name "top_left_corner_motor"
  children [
    Transform { translation 0 0.0225 0 children [
      Shape { appearance DEF ANCHOR_PLATE_APP PBRAppearance { baseColor 0.10 0.11 0.13 roughness 0.7 metalness 0.25 } geometry Box { size 0.085 0.006 0.085 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance DEF ANCHOR_BODY_APP PBRAppearance { baseColor 0.16 0.17 0.19 roughness 0.4 metalness 0.78 } geometry Cylinder { radius 0.028 height 0.052 subdivision 44 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance DEF ANCHOR_BAND_APP PBRAppearance { baseColor 0.45 0.47 0.50 roughness 0.45 metalness 0.5 } geometry Cylinder { radius 0.033 height 0.018 subdivision 44 } } ] }
    Transform { translation 0 0.020 -0.040 children [
      Shape { appearance DEF STATUS_LIGHT_TL PBRAppearance { baseColor 0.90 0.12 0.12 emissiveColor 0.75 0.06 0.06 roughness 0.35 metalness 0.05 } geometry Box { size 0.075 0.005 0.014 } } ] }
  ]
  locked TRUE
}

Solid {
  translation 3.168 2.392 3.3
  name "top_right_corner_motor"
  children [
    Transform { translation 0 0.0225 0 children [
      Shape { appearance USE ANCHOR_PLATE_APP geometry Box { size 0.085 0.006 0.085 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance USE ANCHOR_BODY_APP geometry Cylinder { radius 0.028 height 0.052 subdivision 44 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance USE ANCHOR_BAND_APP geometry Cylinder { radius 0.033 height 0.018 subdivision 44 } } ] }
    Transform { translation 0 0.020 -0.040 children [
      Shape { appearance DEF STATUS_LIGHT_TR PBRAppearance { baseColor 0.90 0.12 0.12 emissiveColor 0.75 0.06 0.06 roughness 0.35 metalness 0.05 } geometry Box { size 0.075 0.005 0.014 } } ] }
  ]
  locked TRUE
}

Solid {
  translation -3.168 2.392 0.3
  name "bottom_left_corner_motor"
  children [
    Transform { translation 0 0.0225 0 children [
      Shape { appearance USE ANCHOR_PLATE_APP geometry Box { size 0.085 0.006 0.085 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance USE ANCHOR_BODY_APP geometry Cylinder { radius 0.028 height 0.052 subdivision 44 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance USE ANCHOR_BAND_APP geometry Cylinder { radius 0.033 height 0.018 subdivision 44 } } ] }
    Transform { translation 0 0.020 -0.040 children [
      Shape { appearance DEF STATUS_LIGHT_BL PBRAppearance { baseColor 0.90 0.12 0.12 emissiveColor 0.75 0.06 0.06 roughness 0.35 metalness 0.05 } geometry Box { size 0.075 0.005 0.014 } } ] }
  ]
  locked TRUE
}

Solid {
  translation 3.168 2.392 0.3
  name "bottom_right_corner_motor"
  children [
    Transform { translation 0 0.0225 0 children [
      Shape { appearance USE ANCHOR_PLATE_APP geometry Box { size 0.085 0.006 0.085 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance USE ANCHOR_BODY_APP geometry Cylinder { radius 0.028 height 0.052 subdivision 44 } } ] }
    Transform { translation 0 0.004 0 rotation 1 0 0 1.5708 children [
      Shape { appearance USE ANCHOR_BAND_APP geometry Cylinder { radius 0.033 height 0.018 subdivision 44 } } ] }
    Transform { translation 0 0.020 -0.040 children [
      Shape { appearance DEF STATUS_LIGHT_BR PBRAppearance { baseColor 0.90 0.12 0.12 emissiveColor 0.75 0.06 0.06 roughness 0.35 metalness 0.05 } geometry Box { size 0.075 0.005 0.014 } } ] }
  ]
  locked TRUE
}

# --- Cable Supervisor (invisible, no geometry) ---
Robot {
  name "cable_supervisor"
  controller "<extern>"
  supervisor TRUE
}
